# Copy this file to .env and fill in values locally (DO NOT COMMIT .env)
#
# Every secret below is REQUIRED and has no default. The backend refuses to
# start if one is missing, too short, or equal to a value that was ever
# published in this repository.

# -------------------------
# DATABASE
# -------------------------
DB_USER=healthcare_app
# Use a long random value, e.g.: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME
DB_NAME=healthcare_auth_db

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/healthcare_auth_db
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# -------------------------
# SECRETS
# -------------------------
# JWT signing key, Base64, >= 32 bytes:   openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# AES-256 file-encryption key, Base64 of exactly 32 bytes:   openssl rand -base64 32
# Rotating this makes previously uploaded files unreadable.
APP_ENCRYPTION_KEY=CHANGE_ME

# -------------------------
# FIRST-RUN ADMINISTRATOR (optional)
# -------------------------
# Used once, only when no ADMIN account exists. Choose a strong password
# (12+ characters, no "password"/"admin"/"qwerty"...), then REMOVE
# APP_ADMIN_PASSWORD from this file after the first successful start.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# -------------------------
# COOKIES / ORIGINS
# -------------------------
# Must be true whenever the site is served over HTTPS.
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -------------------------
# REDIS
# -------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Required: Compose starts Redis with --requirepass. Generate: openssl rand -base64 24
REDIS_PASSWORD=change-me-generate-with-openssl

# -------------------------
# GRAFANA (monitoring UI, loopback only)
# -------------------------
GRAFANA_ADMIN_USER=grafana_admin
# No default: choose a unique password
GRAFANA_ADMIN_PASSWORD=change-me-generate-with-openssl

# -------------------------
# MAIL (staff invites, OTP and password-reset emails)
# -------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@example.com
MAIL_PASSWORD=app-specific-password
